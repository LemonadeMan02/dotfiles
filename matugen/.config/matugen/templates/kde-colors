# Generato da matugen: non modificare, viene riscritto a ogni cambio di wallpaper
# Lo stesso file finisce in due posti:
# - ~/.config/kdeglobals: tema icone, terminale e colori per le app KDE
# - ~/.local/share/color-schemes/Matugen.colors: lo schema che Dolphin applica
#   ([UiSettings] in dolphinrc); senza, fuori da Plasma forza Breeze chiaro

[General]
Name=Matugen
ColorScheme=Matugen
# "Apri terminale qui" (Maiusc+F4) di Dolphin
TerminalApplication=kitty
TerminalService=kitty.desktop

[Icons]
Theme=<* if {{ is_dark_mode }} *>breeze-dark<* else *>breeze<* endif *>

[KDE]
# Doppio click per aprire, come nel resto del desktop
SingleClick=false

[Colors:View]
BackgroundNormal={{colors.surface.default.hex}}
BackgroundAlternate={{colors.surface_container_low.default.hex}}
ForegroundNormal={{colors.on_surface.default.hex}}
ForegroundInactive={{colors.on_surface_variant.default.hex}}
ForegroundActive={{colors.primary.default.hex}}
ForegroundLink={{colors.primary.default.hex}}
ForegroundVisited={{colors.tertiary.default.hex}}
ForegroundNegative={{colors.error.default.hex}}
ForegroundNeutral={{colors.yellow.default.hex}}
ForegroundPositive={{colors.green.default.hex}}
DecorationFocus={{colors.primary.default.hex}}
DecorationHover={{colors.primary.default.hex}}

