#!/bin/sh
# Screenshot di un'area, della finestra attiva o dello schermo col focus.
# Salva in Immagini/Screenshots, copia negli appunti e manda una notifica con l'anteprima.
# Uso: screenshot area|window|screen
set -eu

mode="${1:-area}"

# Cartella Immagini secondo xdg-user-dirs; se manca, il ripiego classico.
pictures="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")"
dir="$pictures/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "$mode" in
  area)
    # Esc durante la selezione = annullato: si esce senza errore e senza notifica.
    geom="$(slurp)" || exit 0
    grim -g "$geom" "$file"
    ;;
  window)
    # Coordinate logiche da Hyprland: sono le stesse che grim -g si aspetta.
    geom="$(hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')"
    grim -g "$geom" "$file"
    ;;
  screen)
    output="$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')"
    grim -o "$output" "$file"
    ;;
  *)
    echo "uso: screenshot area|window|screen" >&2
    exit 2
    ;;
esac

# wl-copy riconosce da solo che e' un PNG.
wl-copy < "$file"

# -i con un percorso: il popup mostra l'anteprima a sinistra.
notify-send -a Screenshot -i "$file" "Screenshot" "$(basename "$file")"
