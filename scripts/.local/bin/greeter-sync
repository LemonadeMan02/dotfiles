#!/bin/sh
# Copia sfondo e colori della sessione in /var/lib/greeter-theme, dove li legge il greeter:
# l'utente greeter non entra nella home. Lo lancia greeter-sync.path a ogni cambio,
# a mano va bene uguale. La cartella la crea greeter/install.sh.
set -eu

dest=/var/lib/greeter-theme
state="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell"

if [ ! -w "$dest" ]; then
  echo "greeter-sync: $dest non scrivibile, lancia greeter/install.sh" >&2
  exit 1
fi

# Copia atomica: il greeter non deve mai leggere un file a meta'
put() {
  cp "$1" "$dest/.$2.tmp"
  chmod 644 "$dest/.$2.tmp"
  mv -f "$dest/.$2.tmp" "$dest/$2"
}

# Senza config.json (shell mai avviata) valgono i default di Config.qml.
# Niente "// true" in jq: tratterebbe false come assente
dynamic="$(jq -r 'if .appearance.dynamicColors == false then "false" else "true" end' \
  "$state/config.json" 2>/dev/null || echo true)"
wallpaper="$(jq -r '.appearance.wallpaper // ""' "$state/config.json" 2>/dev/null || echo "")"

# Colori dinamici spenti nella shell: Catppuccin anche nel greeter
if [ "$dynamic" = true ] && [ -r "$state/colors.json" ]; then
  put "$state/colors.json" colors.json
else
  rm -f "$dest/colors.json"
fi

# Lo sfondo pesa: si ricopia solo se e' cambiato file o contenuto
if [ -n "$wallpaper" ] && [ -r "$wallpaper" ]; then
  if [ "$(cat "$dest/wallpaper.source" 2>/dev/null)" != "$wallpaper" ] ||
     [ "$wallpaper" -nt "$dest/wallpaper" ]; then
    put "$wallpaper" wallpaper
    printf '%s\n' "$wallpaper" > "$dest/wallpaper.source"
  fi
else
  rm -f "$dest/wallpaper" "$dest/wallpaper.source"
fi
