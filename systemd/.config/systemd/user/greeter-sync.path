# Sfondo, colori o tema cambiati nella shell: aggiorna la copia letta dal greeter
[Unit]
Description=Sfondo e colori per il greeter

[Path]
# config.json: sfondo scelto e colori dinamici on/off; colors.json: palette di matugen
PathChanged=%h/.local/state/quickshell/config.json
PathChanged=%h/.local/state/quickshell/colors.json

[Install]
WantedBy=default.target
