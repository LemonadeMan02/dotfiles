# Shell: riparte da sola se crasha, log in journalctl --user -u quickshell
[Unit]
Description=Quickshell desktop shell
Documentation=https://quickshell.org/docs
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# Parte sotto l'animazione d'ingresso, non prima; "-": se manca lo script parte lo stesso
ExecStartPre=-%h/.local/bin/session-intro wait
ExecStart=/usr/bin/quickshell
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
